rules_version = '2';
// ═══════════════════════════════════════════════════════════════════════════
//  SentiqS — règles Firestore (plan gratuit Spark, pas de fonction serveur)
//
//  Elles remplacent, pour Firebase, ce que faisaient côté Supabase les
//  politiques RLS et les déclencheurs de
//  app/sentinel-app/supabase/migrations/20260718020000_profiles_auth.sql :
//    · seules les adresses des administrateurs (celle de la migration
//      Supabase, plus a3fyee@gmail.com, compte de la console Firebase, à la
//      demande de YORO le 21/10/2026), VÉRIFIÉES, peuvent porter le rôle
//      admin ; tout autre profil naît « user » et « active » ;
//    · un utilisateur ne peut jamais changer son propre rôle ni son statut ;
//    · un utilisateur ne lit et n'écrit que son profil ; l'administrateur
//      lit, modifie et supprime tous les profils.
//  Ce fichier n'est pas servi par Pages (hors de web/) : l'adresse de
//  l'administrateur n'apparaît pas dans le code envoyé au navigateur.
//
//  À coller dans la console Firebase > Firestore > Règles (ou
//  `firebase deploy --only firestore:rules`). Testé par
//  scripts/test/firebase.test.js (forme), pas par l'émulateur.
// ═══════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function emailAdmin() {
      return connecte()
        && request.auth.token.email in ['yorot225@gmail.com', 'a3fyee@gmail.com']
        && request.auth.token.email_verified == true;
    }
    function estAdmin() {
      return emailAdmin()
        || (connecte() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin');
    }

    // Champs commerciaux d'un profil (13/11/2026, bloquant de vente) : le
    // forfait, le paiement, l'échéance, l'accès et le quota sont posés par
    // l'administrateur. Avant, un utilisateur ne pouvait pas changer son rôle
    // mais pouvait se passer lui-même en forfait payant en réécrivant `data`.
    function champ(d, nom) { return d.get('data', {}).get(nom, null); }
    function inchange(nom) { return champ(request.resource.data, nom) == champ(resource.data, nom); }
    function commercialInchange() {
      return inchange('plan') && inchange('paiement') && inchange('echeance')
        && inchange('dlQuotaOverride') && inchange('accesJusquau')
        // La date de création décide de l'essai de 72 h : posée une fois,
        // jamais réécrite (un profil ancien sans date peut la recevoir).
        && (inchange('createdAt') || champ(resource.data, 'createdAt') == null);
    }
    function profilActif() {
      return connecte()
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.status == 'active';
    }

    match /profiles/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || estAdmin());
      allow create: if connecte() && request.auth.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.status == 'active'
        && (request.resource.data.role == 'user'
            || (request.resource.data.role == 'admin' && emailAdmin()))
        // Un compte naît au forfait gratuit, sans paiement ni accès prolongé.
        && (estAdmin() || (champ(request.resource.data, 'plan') in [null, 'gratuit']
            && champ(request.resource.data, 'paiement') == null
            && champ(request.resource.data, 'echeance') == null
            && champ(request.resource.data, 'dlQuotaOverride') == null
            && champ(request.resource.data, 'accesJusquau') == null));
      allow update: if connecte() && (
        estAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.id == resource.data.id
            && commercialInchange()));
      // Un utilisateur supprime son propre profil (exigence du Play Store,
      // 13/11/2026) ; jamais celui d'un autre, et jamais un profil admin.
      allow delete: if estAdmin()
        || (connecte() && request.auth.uid == uid && resource.data.role != 'admin');
    }

    // Journal des connexions : chacun écrit la sienne, seul l'admin lit.
    match /connexions_log/{id} {
      allow create: if connecte() && request.resource.data.email == request.auth.token.email;
      allow read: if estAdmin();
    }

    // Cache d'actus et agenda partagés (web/js/cache-firestore.js). Lisibles
    // par les seuls comptes actifs depuis le 13/11/2026 (bloquant de vente :
    // ils étaient lisibles sans compte par l'API REST). La page envoie le
    // jeton du compte ; le job de collecte lit et écrit avec son compte de
    // service (IAM), qui ne passe pas par ces règles. Aucune écriture depuis
    // un navigateur.
    match /collecte_partagee/{id} {
      allow read: if profilActif();
      allow write: if false;
    }

    // Validation des faits par un analyste (13/11/2026). L'état courant est
    // lu par tout compte connecté (c'est ce que le client voit sur le fait) ;
    // seul un administrateur l'écrit, en son propre nom, avec une décision
    // et une grille de l'Amirauté valides. Jamais supprimé : une validation
    // se corrige par une nouvelle décision, qui reste dans le journal.
    function validationBienFormee(d) {
      return d.decision in ['confirme', 'infirme']
        && d.source in ['A', 'B', 'C', 'D', 'E', 'F']
        && ((d.decision == 'confirme' && d.info in ['1', '2', '3'])
            || (d.decision == 'infirme' && d.info in ['4', '5']))
        && d.par == request.auth.token.email
        && d.parUid == request.auth.uid
        && d.note is string && d.note.size() <= 500;
    }
    match /validations/{cle} {
      allow read: if connecte();
      allow create, update: if estAdmin()
        && request.resource.data.cle == cle
        && validationBienFormee(request.resource.data);
      allow delete: if false;
    }
    // Journal des décisions : une ligne par décision, ni modifiable ni
    // effaçable, même par l'administrateur. C'est la trace « qui a validé
    // quoi et quand ».
    match /journal_validations/{id} {
      allow create: if estAdmin() && validationBienFormee(request.resource.data);
      allow read: if estAdmin();
      allow update, delete: if false;
    }

    // Paiement déclaré (13/11/2026, bloquant de vente). Avant, la
    // déclaration du client et les numéros Mobile Money ne vivaient que dans
    // le localStorage de chaque navigateur : le client ne voyait aucun numéro
    // et l'administrateur ne recevait jamais sa déclaration.
    //
    // Moyens de paiement : un seul document « courant », lu par tout compte
    // connecté (le client doit voir le numéro vers lequel payer), écrit par
    // l'administrateur seul.
    match /moyens_paiement/{id} {
      allow read: if connecte();
      allow write: if estAdmin() && id == 'courant';
    }
    // Déclarations : le client crée la sienne, à son nom, « à vérifier » ;
    // il ne lit que les siennes. Seul l'administrateur lit tout et tranche
    // (confirmé / rejeté), sans toucher au contenu déclaré. Jamais effacées :
    // c'est la trace de l'encaissement.
    function declarationBienFormee(d) {
      return d.keys().hasOnly(['uid', 'email', 'nom', 'planKey', 'plan', 'montant', 'moyen',
                               'reference', 'note', 'statut', 'date', 'created_at'])
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && d.statut == 'a_verifier'
        && d.planKey is string && d.planKey.size() <= 40
        && d.moyen is string && d.moyen.size() <= 60
        && d.reference is string && d.reference.size() > 0 && d.reference.size() <= 80
        && d.note is string && d.note.size() <= 500;
    }
    match /paiements_declares/{id} {
      allow create: if connecte() && declarationBienFormee(request.resource.data);
      allow read: if connecte() && (resource.data.uid == request.auth.uid || estAdmin());
      allow update: if estAdmin()
        && request.resource.data.statut in ['confirme', 'rejete']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['statut', 'traitePar', 'traiteLe', 'updated_at']);
      allow delete: if false;
    }

    // Bulletins programmés (14/11/2026). La programmation d'un compte tient
    // en UN document (sa liste), pour que la règle puisse compter : le nombre
    // de programmations ne dépasse jamais ce que permet le forfait LU DANS LE
    // PROFIL (1 Particulier, 5 Professionnel, 20 Institution, 0 Découverte),
    // mêmes nombres que LIMITES_FORFAIT dans web/js/bulletin-message.js. Le
    // job revérifie tout (forfait, accès, contenu) avant chaque envoi.
    function limiteBulletins() {
      let plan = get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('data', {}).get('plan', 'gratuit');
      return emailAdmin() ? 20 : (plan == 'entreprise' ? 20 : (plan == 'pro' ? 5 : (plan == 'standard' ? 1 : 0)));
    }
    function programmationBienFormee(d, uid) {
      return d.keys().hasOnly(['id', 'uid', 'email', 'programmations', 'telegramCode', 'maj', 'updated_at', 'created_at'])
        && d.id == uid && d.uid == uid
        && d.email == request.auth.token.email
        && d.programmations is list
        && (d.programmations.size() == 0 || d.programmations.size() <= limiteBulletins())
        && (!('telegramCode' in d) || d.telegramCode == null || (d.telegramCode is string && d.telegramCode.matches('^[a-f0-9]{16}$')));
    }
    match /bulletins_programmes/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || estAdmin());
      allow create, update: if connecte() && request.auth.uid == uid && profilActif()
        && programmationBienFormee(request.resource.data, uid);
      allow delete: if connecte() && (request.auth.uid == uid || estAdmin());
    }
    // État des envois (créneaux passés, destinataires et leur accord, chat
    // Telegram relié) : écrit par le job seul (compte de service), lu par son
    // titulaire. « _canaux » dit à tous les comptes connectés quels canaux
    // l'éditeur a réellement branchés.
    match /bulletins_etat/{id} {
      allow read: if connecte() && (request.auth.uid == id || id == '_canaux' || estAdmin());
      allow write: if false;
    }
    // Identifiants d'envoi apportés par l'utilisateur (14/11/2026) : son
    // compte WhatsApp Business (jeton Meta) et/ou le serveur d'envoi de sa
    // boîte e-mail (SMTP). Le secret arrive DÉJÀ CHIFFRÉ par la page avec la
    // clé publique du job (web/js/identifiants-envoi.js) ; seul le job peut le
    // relire. Aucune lecture depuis un navigateur, y compris par son auteur :
    // on remplace ou on efface ses identifiants, on ne les relit jamais.
    function chiffreBienForme(c) {
      return c is map && c.keys().hasOnly(['v', 'cle', 'iv', 'donnees'])
        && c.v == 1 && c.cle is string && c.cle.size() <= 1200
        && c.iv is string && c.iv.size() <= 40 && c.donnees is string && c.donnees.size() <= 1600;
    }
    match /whatsapp_comptes/{uid} {
      allow read: if false;
      allow create, update: if connecte() && request.auth.uid == uid && profilActif()
        && request.resource.data.keys().hasOnly(['id', 'chiffre', 'numeroId', 'modele', 'langue', 'essai', 'essaiDemande', 'maj', 'updated_at', 'created_at'])
        && chiffreBienForme(request.resource.data.chiffre)
        && request.resource.data.numeroId is string && request.resource.data.numeroId.matches('^[0-9]{8,25}$')
        && request.resource.data.modele is string && request.resource.data.modele.matches('^[a-z0-9_]{1,512}$')
        && request.resource.data.langue is string && request.resource.data.langue.matches('^[a-z]{2,3}(_[A-Z]{2})?$')
        && (!('essai' in request.resource.data) || request.resource.data.essai == null
            || (request.resource.data.essai is string && request.resource.data.essai.matches('^[0-9]{8,15}$')))
        && (!('essaiDemande' in request.resource.data) || request.resource.data.essaiDemande == null
            || (request.resource.data.essaiDemande is string && request.resource.data.essaiDemande.size() <= 40));
      allow delete: if connecte() && request.auth.uid == uid;
    }
    match /smtp_comptes/{uid} {
      allow read: if false;
      allow create, update: if connecte() && request.auth.uid == uid && profilActif()
        && request.resource.data.keys().hasOnly(['id', 'chiffre', 'hote', 'port', 'utilisateur', 'expediteur', 'nom', 'essaiDemande', 'maj', 'updated_at', 'created_at'])
        && chiffreBienForme(request.resource.data.chiffre)
        && request.resource.data.hote is string && request.resource.data.hote.size() <= 253
        && request.resource.data.hote.matches('^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?[.])+[a-z]{2,24}$')
        && request.resource.data.port in [465, 587]
        && request.resource.data.utilisateur is string && request.resource.data.utilisateur.size() <= 200
        && request.resource.data.expediteur is string && request.resource.data.expediteur.size() <= 254
        && (!('nom' in request.resource.data) || (request.resource.data.nom is string && request.resource.data.nom.size() <= 60))
        && (!('essaiDemande' in request.resource.data) || request.resource.data.essaiDemande == null
            || (request.resource.data.essaiDemande is string && request.resource.data.essaiDemande.size() <= 40));
      allow delete: if connecte() && request.auth.uid == uid;
    }
    match /bulletins_instantanes/{id} {
      allow read, write: if false;
    }
    // Réponse d'un destinataire e-mail tiers (« J'accepte » / « Je refuse »,
    // lien reçu par e-mail, page web/abonnement.html, sans compte). Le jeton
    // de 40 caractères n'existe que dans la boîte du destinataire : le
    // connaître prouve qu'on la lit. Écriture seule, une décision et sa date ;
    // personne ne relit ces documents hors du job.
    match /reponses_destinataires/{jeton} {
      allow create, update: if jeton.matches('^[a-f0-9]{40}$')
        && request.resource.data.keys().hasOnly(['decision', 'le'])
        && request.resource.data.decision in ['oui', 'non']
        && request.resource.data.le is string && request.resource.data.le.size() <= 40;
      allow read, delete: if false;
    }

    // Tout le reste est fermé tant qu'une PR ne l'ouvre pas explicitement
    // (agenda, configuration partagée : étape suivante).
  }
}
